# Copy to .env and adjust. Every value here has a working default, so the app
# runs without this file at all — it exists to make the deployment decisions
# visible rather than buried in source. See docs/DEPLOY.md.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required when NODE_ENV=production; the app refuses to start without it rather
# than silently falling back to the development credentials.
# The compose file builds this from the POSTGRES_* values below, so you only
# set it here when running the app outside a container.
DATABASE_URL=postgresql://agentoncall:agentoncall@127.0.0.1:5432/agentoncall

# Used by docker-compose to create the database. CHANGE THE PASSWORD before
# this is reachable from anywhere but your own machine.
#POSTGRES_USER=agentoncall
#POSTGRES_PASSWORD=agentoncall
#POSTGRES_DB=agentoncall

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Which proxy to believe for X-Forwarded-* headers.
#
#   loopback  (default) — a proxy on the same host, e.g. cloudflared
#   1                   — exactly one proxy hop in front, e.g. a proxy container
#   false               — nothing in front; do not trust forwarded headers
#   loopback,10.0.0.0/8 — a list of addresses or subnets
#
# Setting this wrong behind a TLS proxy makes every mutating request fail the
# origin check with a 403. If login breaks in a deployment, check this first.
#TRUST_PROXY=loopback

# Bind address. The default is loopback: an unconfigured app should not appear
# on a public interface. Containers set 0.0.0.0 because the port mapping is the
# isolation.
#HOST=127.0.0.1
PORT=3000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
#NODE_ENV=development

# Apply migrations on start. Off by default so a schema change stays a
# deliberate step; docker-compose sets it to 1 for first-run convenience.
#RUN_MIGRATIONS=0

# Keep the build context to what the image actually needs. Without this, the
# context includes local build output and ignored local secrets.

node_modules
dist

.git
.gitignore

.env
.env.local
# Every env file, not a list of them. A cloud build context is uploaded to GCS,
# so anything matched here is what keeps a database password out of a bucket
# someone else's job can read.
.env.*
DEMO-CREDENTIALS.local.md
*.log
*.tsbuildinfo

# Not needed to build or run.
docs
tests
*.md
